                    RotationalMotor {
                      name "lf_tibia"
                      maxVelocity 3.0
                      maxTorque 0.5
                      minPosition -1.5708
                      maxPosition 1.5708
                      controlPID 10 0 0
                    }
                    PositionSensor {
