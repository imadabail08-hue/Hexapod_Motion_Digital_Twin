#VRML_SIM R2023b utf8
# Hexapod Digital Twin — Webots World
# Generated for Hexapod Digital Twin project

WorldInfo {
  title "Hexapod Digital Twin"
  info [
    "6-legged robot simulation"
    "18 DoF hexapod with IMU, gyro, accelerometer"
    "Controller: twin_controller"
  ]
  basicTimeStep 8
  contactProperties [
    ContactProperties {
      material1 "floor"
      material2 "foot"
      coulombFriction [ 0.5 ]
      softERP 0.2
      softCFM 0.001
    }
  ]
}

Background {
  skyColor [
    0.1 0.1 0.12
    0.08 0.08 0.1
    0.05 0.05 0.07
  ]
  luminosity 0.3
}

DirectionalLight {
  ambientIntensity 0.3
  color 1 0.95 0.9
  direction -0.5 -1 -0.3
  intensity 1.2
  castShadows TRUE
}

PointLight {
  attenuation 0 0 1
  color 0.6 0.7 1.0
  intensity 0.8
  location 0.5 1.0 0.5
  castShadows FALSE
}

# Floor — infinite plane with ODE physics
DEF FLOOR Solid {
  contactMaterial "floor"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.12 0.12 0.15
        roughness 0.9
        metalness 0.0
      }
      geometry Plane {
        size 10 10
      }
    }
  ]
  boundingObject Plane {
    size 10 10
  }
  physics Physics {
    density -1
    mass 0
  }
  locked TRUE
}

# Grid overlay for visual reference
DEF GRID_LINES Shape {
  appearance PBRAppearance {
    baseColor 0.2 0.2 0.25
    roughness 1.0
    metalness 0.0
    emissiveColor 0.05 0.05 0.08
  }
  geometry Plane {
    size 5 5
  }
}

# ===========================================================
# HEXAPOD ROBOT
# ===========================================================
DEF HEXAPOD Robot {
  translation 0 0.06 0
  rotation 0 1 0 0
  name "hexapod"
  model "MakerBoard Hexapod MG90S"
  controller "twin_controller"
  supervisor FALSE
  physics Physics {
    density -1
    mass 0.8
    centerOfMass [ 0 0 0 ]
    inertiaMatrix [
      0.001 0.002 0.001
      0 0 0
    ]
  }
  boundingObject Box {
    size 0.18 0.05 0.12
  }
  children [

    # -------------------------------------------------------
    # IMU / Gyro / Accelerometer
    # -------------------------------------------------------
    InertialUnit {
      name "imu"
      translation 0 0.015 0
      rotation 0 1 0 0
      noise 0.001
      resolution -1
    }
    Gyro {
      name "gyro"
      translation 0 0.015 0
      noise 0.001
    }
    Accelerometer {
      name "accelerometer"
      translation 0 0.015 0
      noise 0.05
    }

    # -------------------------------------------------------
    # BODY SHAPE
    # -------------------------------------------------------
    DEF BODY Shape {
      appearance PBRAppearance {
        baseColor 0.08 0.08 0.1
        roughness 0.4
        metalness 0.8
        emissiveColor 0.02 0.02 0.04
      }
      geometry Box {
        size 0.18 0.04 0.12
      }
    }

    # Body center indicator
    Shape {
      appearance PBRAppearance {
        baseColor 0.0 0.5 1.0
        emissiveColor 0.0 0.3 0.8
        metalness 0.0
        roughness 0.2
      }
      geometry Sphere {
        radius 0.008
      }
    }

    # -------------------------------------------------------
    # LEG 1: LF (Left Front)
    # -------------------------------------------------------
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 0 1
        anchor -0.08 0 0.06
      }
      device [
        RotationalMotor {
          name "lf_coxa"
          maxVelocity 3.0
          maxTorque 0.5
          minPosition -1.5708
          maxPosition 1.5708
          controlPID 10 0 0
        }
        PositionSensor {
          name "lf_coxa_sensor"
        }
      ]
      endPoint Solid {
        translation -0.08 0 0.06
        rotation 0 0 1 0
        name "lf_coxa_link"
